# Copy this file to .env and fill in real values.
# .env is gitignored; never commit real credentials.

# Neon PostgreSQL connection string (used by Drizzle in packages/core and drizzle-kit).
DATABASE_URL=

# Firebase Admin service account JSON, minified to a single line (used by apps/backend
# to verify Firebase ID tokens). Example shape:
# {"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
FIREBASE_SERVICE_ACCOUNT=

# Firebase Web app config (used by apps/frontend to initialize the Firebase Client SDK).
# These are exposed to the browser bundle; do not put server-only secrets here.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
