{
  "name": "omnistack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "// dev": "Starts the full dev environment (SST v3 + Stripe CLI webhook tunnel)",
    "dev": "concurrently -k -n \"SST,STRIPE\" -c \"cyan,magenta\" \"sst dev\" \"pnpm --filter backend stripe:listen\"",
    "// db": "Pushes the current Drizzle schema directly to Neon DB",
    "db": "drizzle-kit push",
    "// db:studio": "Launches the visual database browser on http://localhost:4983",
    "db:studio": "drizzle-kit studio",
    "// stripe:login": "Authenticates the Stripe CLI with your Stripe account",
    "stripe:login": "pnpm --filter backend stripe:login",
    "build": "pnpm -r build",
    "setup:stripe": "tsx scripts/setup-stripe.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:generate": "drizzle-kit generate",
    "db:push": "sst shell drizzle-kit push"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "download",
      "version": "^11.13.1"
    }
  },
  "type": "module",
  "dependencies": {
    "sst": "4.17.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.162",
    "concurrently": "^10.0.5",
    "drizzle-kit": "catalog:"
  },
  "overrides": {
    "h3": "1.15.0"
  }
}
